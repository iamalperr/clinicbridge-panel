# ==========================================
# FIREBASE ADMIN CREDENTIALS (LOCAL CLI)
# ==========================================
# Geliştirme ortamında (local CLI scriptleri için) Firebase yetkilendirmesi için aşağıdaki üç moddan BİRİNİ seçin.
# DİKKAT: .env.local dosyasına gerçek değerleri girin ve bu dosyayı ASLA git'e commit etmeyin.
# ==========================================

# ------------------------------------------
# MOD A: Service Account Fields (Önerilen/Klasik Yöntem)
# Firebase Console > Project Settings > Service Accounts üzerinden yeni bir private key oluşturun.
# İndirilen JSON içindeki değerleri buraya yapıştırın.
# Private Key içindeki \n karakterleri aynen (string olarak) kalabilir veya gerçek alt satır olabilir.
# ------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# ------------------------------------------
# MOD B: Base64 Service Account JSON (Vercel Production Benzeri)
# İndirilen Service Account JSON dosyasının tamamını base64 ile encode edip tek satırda buraya yapıştırın.
# (Eğer bu kullanılıyorsa üstteki A modunu boş bırakın)
# ------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_BASE64="eyJwcm9qZWN0X2lkIjoi..."

# ------------------------------------------
# MOD C: Application Default Credentials (ADC)
# Terminalinizde `gcloud auth application-default login` çalıştırdıysanız, 
# sadece FIREBASE_PROJECT_ID tanımlamanız yeterlidir.
# ------------------------------------------
# FIREBASE_PROJECT_ID="your-project-id"

# ==========================================
# WHATSAPP CLOUD API (Meta) — clinic staff notifications
# ==========================================
# Values belong in .env.local / Vercel Production. Never commit real secrets.
# Kill switch: sending is allowed only when WHATSAPP_NOTIFICATIONS_ENABLED=true
# and the send credentials below are present.
# ------------------------------------------
WHATSAPP_NOTIFICATIONS_ENABLED=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional; defaults to v25.0 when empty or invalid
WHATSAPP_GRAPH_VERSION=
