rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Demo requests: anyone can CREATE (landing page form), only authenticated users can read/update
    match /demoRequests/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Agency collections: authenticated users only
    match /agencies/{agencyId} {
      allow read, write: if request.auth != null;
      
      match /clinics/{docId} {
        allow read, write: if request.auth != null;

        // Sub-collections under clinics (pricing, etc.)
        match /{subcol}/{subId} {
          allow read, write: if request.auth != null;
        }
      }
      
      match /leads/{leadId} {
        allow read, write: if request.auth != null;
      }

      // Config and other sub-collections
      match /{subcol}/{subId} {
        allow read, write: if request.auth != null;
      }
    }

    // AI Usage tracking is purely backend-driven (via admin SDK). 
    // Client should use API endpoints.
    match /aiUsage/{docId} {
      allow read, write: if false;
    }
    match /aiUsageDaily/{docId} {
      allow read, write: if false;
    }
    match /aiModelPricing/{docId} {
      allow read, write: if false;
    }

    // All other collections require authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
