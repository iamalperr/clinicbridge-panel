rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Voice infrastructure is server-only: clients are denied, the Firebase Admin SDK bypasses rules.
    // Rules are additive, so these ids must also be excluded from the catch-all below;
    // the explicit deny blocks alone cannot override another matching allow.
    function isServerOnlyCollection(collectionId) {
      return collectionId in [
        'voiceNumbers',
        'voiceCallSessions',
        'voiceCalls',
        'voiceRuntimeLeases',
        'voiceSettings',
        'voiceProfiles'
      ];
    }

    match /voiceNumbers/{document=**} {
      allow read, write: if false;
    }

    match /voiceCallSessions/{document=**} {
      allow read, write: if false;
    }

    match /voiceCalls/{document=**} {
      allow read, write: if false;
    }

    match /voiceRuntimeLeases/{document=**} {
      allow read, write: if false;
    }

    // Voice control plane: written only through the validated, audited admin API.
    match /voiceSettings/{document=**} {
      allow read, write: if false;
    }

    match /voiceProfiles/{document=**} {
      allow read, write: if false;
    }

    // Every other path: authenticated clients only (current production behavior).
    // Unlike a root `match /{document=**}`, this pattern does not authorize client
    // collection-group queries. Do not add a broad recursive rule to restore them:
    // it would re-grant nested paths under the voice collections.
    match /{collectionId}/{document=**} {
      allow read, write: if request.auth != null
        && !isServerOnlyCollection(collectionId);
    }
  }
}
