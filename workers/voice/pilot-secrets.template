# ClinicBridge voice worker — LiveKit Cloud secret NAMES for the staff pilot (no values).
#
# Copy to a file OUTSIDE the repository (e.g. ~/.clinicbridge/voice-pilot.secrets, chmod 600),
# fill values there, and pass it explicitly: lk agent create --secrets-file=<that file>.
# Never copy the root .env.local; never commit a filled copy.
# LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET are injected by LiveKit Cloud — do not set.

# REQUIRED
LIVEKIT_AGENT_NAME=clinicbridge-voice
CLINICBRIDGE_VOICE_TTS_VOICE_ID=
CLINICBRIDGE_VOICE_ALLOWED_SIP_TRUNK_IDS=
CLINICBRIDGE_VOICE_ALLOWED_SIP_RULE_IDS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
OPENAI_API_KEY=

# OPTIONAL (appointment / clinic notification emails; omit to disable email side effects)
RESEND_API_KEY=
EMAIL_FROM=

# MUST_BE_UNSET (do not add): LIVEKIT_AGENT_NAME_OVERRIDE, NEXT_PUBLIC_FIREBASE_*,
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT, LIVEKIT_DEV_MODE, LK_KEYTERMS_DEBUG,
# LIVEKIT_DEBUG_LOG_ROOM_EVENTS. LOG_LEVEL may only be unset or "error".
